{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Neutrino Documentation",
  "colors": {
    "primary": "#FFC500",
    "light": "#FFC500",
    "dark": "#6A00FF"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart",
          "installation"
        ]
      },
      {
        "group": "Protocol Architecture",
        "pages": [
          "protocol/nwp-v2-wire",
          "protocol/crypto-model",
          "protocol/flow-control"
        ]
      },
      {
        "group": "Guides & Workflows",
        "pages": [
          "guide/file-beam",
          "guide/troubleshooting",
          "guide/swarm-sync",
          "guide/singularity-git",
          "guide/mesh-vpn"
        ]
      },
      {
        "group": "Developer Reference",
        "pages": [
          "api-reference/cli",
          "api-reference/json-rpc"
        ]
      },
      {
        "group": "Infrastructure",
        "pages": [
          "self-hosting/coordinator",
          "self-hosting/relay",
          "releasing"
        ]
      },
      {
        "group": "Implementation reference",
        "pages": [
          "spec/beta-interface"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/NeutrinoEncryption/neutrino",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/NeutrinoEncryption/neutrino"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download CLI",
      "href": "https://neutrinoapi.peretas.live/dl/latest/"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/NeutrinoEncryption/neutrino"
    }
  },
  "background": {
    "color": {
      "dark": "#0C0C0C",
      "light": "#FFFFFF"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/index"
    },
    {
      "source": "/spec/BETA_INTERFACE",
      "destination": "/spec/beta-interface"
    }
  ]
}
