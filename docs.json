{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Neutrino Documentation",
  "colors": {
    "primary": "#FFC500",
    "light": "#FFD640",
    "dark": "#6A00FF"
  },
  "favicon": "/favicon.svg",
